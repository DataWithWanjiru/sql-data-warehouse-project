
SELECT cst_id, COUNT(*) FROM
(
SELECT ci.[cst_id]
      ,ci.[cst_key]
      ,ci.[cst_firstname]
      ,ci.[cst_lastname]
      ,ci.[cst_marital_status]
      ,ci.[cst_gndr]
      ,ci.[cst_create_date]
	  ,ca.bdate
	  ,ca.gen
	  ,lc.cntry
  FROM [DataWarehouse].[Silver].[crm_cust_info] ci
  LEFT JOIN [DataWarehouse].[Silver].[erp_cust_az12] ca
  ON ci.[cst_key]=ca.cid
  LEFT JOIN [DataWarehouse].[Silver].[erp_loc_a101] lc
  ON ci.[cst_key]=lc.cid
  ) t
  GROUP BY cst_id 
  HAVING COUNT(*)> 1

