
/*This code checks whether we have products in the products table
which do not have an order from the sales table

You can do the opposite to check whether we have producst ain the sales category which
do not have a product presence in the products table.*/

SELECT [prd_id]
	    ,[prd_key]
      ,SUBSTRING(REPLACE([prd_key],'-','_'),1,5) AS cat_id
	    ,SUBSTRING(prd_key,7,LEN(prd_key)) AS prd_key
      ,[prd_nm]
      ,[prd_cost]
      ,[prd_line]
      ,[prd_start_dt]
      ,[prd_end_dt]
 FROM [DataWarehouse].[Bronze].[crm_prd_info]
 WHERE SUBSTRING(prd_key,7,LEN(prd_key)) NOT IN 
(SELECT sls_prd_key FROM [DataWarehouse].[Bronze].[crm_sales_details])

